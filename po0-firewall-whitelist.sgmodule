#!name=po0 防火墙自动加白
#!desc=调用 po0 防火墙 API 将本机当前出口 IP 加入白名单。支持多 token、network-changed 事件即时触发与每 5 分钟节点检测（po0-hk-snell 断连时自动加白），附手动刷新面板。
#!category=po0
#!author=kofttlcc
#!arguments=tokens:"",node:"po0-hk-snell"
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号分割；node: 定时连通性测试节点名称，默认 po0-hk-snell

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/30 * * * *",script-path=https://raw.githubusercontent.com/kofttlcc/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/kofttlcc/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&node={{{node}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/kofttlcc/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&node={{{node}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙加白,content=点击刷新,update-interval=300
